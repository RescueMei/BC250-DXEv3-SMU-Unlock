## @file
#  BC250DXEv3SMUUnlockPkg
#
#  DXE driver package that carries out rw-r-r-0644's BC-250 SMU secure-access
#  unlock (https://github.com/rw-r-r-0644/bc250-smu-unlock).
#
#  Copyright (C) 2026 RescueMei
#  SPDX-License-Identifier: MIT
##

[Defines]
  DEC_SPECIFICATION              = 0x0001001A
  PACKAGE_NAME                   = BC250DXEv3SMUUnlock
  PACKAGE_GUID                   = D20E4D7C-2F6A-4BBA-9C14-5E3FA8B1C6D3
  PACKAGE_VERSION                = 0.1

[Includes]
  Include

[Protocols]
  ## SMU secure-access unlock protocol.  Published unconditionally as an
  #  ordering marker for consumers' [Depex]; also exposes Grant(), which
  #  performs the unlock on demand regardless of the SmuUnlock variable.
  gMeiMeiDXEv3SmuUnlockProtocolGuid = { 0xA7C3D5E1, 0x94B2, 0x4C6D, { 0x8F, 0x1A, 0x3B, 0x5D, 0x7E, 0x9C, 0x2F, 0x68 } }
